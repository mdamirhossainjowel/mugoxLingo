# Copy this file to .env.local and fill it in. Never commit .env.local.

# Public address of the site. Used for canonical links, hreflang, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres connection string (Neon console > Connect). The pooled "-pooler" host is fine.
# Without it the app still works for guests; accounts stay off.
DATABASE_URL=

# Contact address shown on the contact page (optional)
NEXT_PUBLIC_CONTACT_EMAIL=

# Analytics (optional). Use a NEW GA4 property for this app, never the id of another MugoX site.
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (optional)
NEXT_PUBLIC_GSC_VERIFICATION=

# Google AdSense publisher id (optional). Ads only load after the visitor accepts cookies, and only on the home and About pages.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Optional ad unit id from AdSense (Ads > By ad unit). Without it, no manual ad is shown on the page.
NEXT_PUBLIC_ADSENSE_SLOT=
# Set to true only if you want personalized ads. Off by default because children also use the site.
NEXT_PUBLIC_ADSENSE_PERSONALIZED=false

# Optional: open `npm run dev` from your phone on the same Wi-Fi (comma separated IPs)
NEXT_DEV_ORIGINS=
